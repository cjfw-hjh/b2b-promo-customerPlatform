{
  "name": "b2b-promo-backend",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec \"node --env-file=.env\" src/server.js",
    "lint": "eslint .",
    "test": "node --env-file=.env node_modules/jest/bin/jest.js --coverage --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/server.js"
    ]
  }
}
